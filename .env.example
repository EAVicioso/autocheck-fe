# Backend REST (solo servidor)
AUTOCHECK_API_URL=http://localhost:5004
AUTOCHECK_API_TIMEOUT_MS=10000
# Origen público exacto si un proxy altera el host visto por Next
AUTOCHECK_APP_ORIGIN=

# Opcionales para Broadcast. Clave publicable del proyecto, nunca service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_REALTIME_PRIVATE=false
